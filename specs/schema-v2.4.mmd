---
title: Compliance assessment schema (v2.4)
---
%% Target: Aurora PostgreSQL 15 or later, with pgvector 0.8 or later.
%% Primary keys are UUIDv7, generated by the application, so they sort by creation time.
%% Mermaid cannot draw enums, indexes or CHECKs. Enum values are listed below.
%% Indexes and constraints are listed in a comment above each table.
%% -
%% ---------- Enums ----------
%% user_role: consultant, admin, client
%% engagement_status: draft, active, closed
%% scope_item_type: system, asset, vendor
%% document_status: pending, processing, ready, failed
%% mapping_relationship: equivalent, subset, superset, related
%% mention_method: alias, llm
%% run_status: queued, running, completed, failed
%% preliminary_verdict: preliminary_pass, preliminary_fail, interpretation_required, insufficient_evidence
%% final_verdict: pass, fail, insufficient_evidence
%% review_flag_reason: decision_superseded, document_deleted, document_replaced
%% -
%% ---------- Engagement isolation ----------
%% Every table with engagement_id references its engagement-scoped parents by (id, engagement_id).
%% Each parent has UNIQUE (id, engagement_id) for this. A row can never point into another engagement.
%% -
%% ---------- Application rules (not enforced by the database) ----------
%% Only a consultant or admin can lead an engagement, start a run or record a decision.
%% A closed engagement is read-only. The access check enforces this.
%% Recording a decision locks the assessment (SELECT ... FOR SHARE) and returns 409 if it is no longer current.
%% Open-flag counts include only flags on current assessments.
%% Search queries repeat the partial HNSW index condition exactly; a test checks the plan uses the index.
%% Every engagement write locks the engagement row FOR SHARE; closing locks it FOR UPDATE.
%% Adding or activating criteria locks the control's row first.
%% Saving an assessment: lock and un-current the earlier assessment, read its decisions, lock the cited
%% chunks and drop citations to deleted ones, then insert the assessment, citations and any flag.
%% Only the engagement's latest run can be resumed.
%% The sweeper fails unconfirmed uploads after 30 minutes and runs with no progress for 30 minutes.
%% A decision is "accepted" when final_verdict matches the preliminary verdict
%% (preliminary_pass to pass, preliminary_fail to fail, insufficient_evidence to insufficient_evidence).
%% Any other final verdict is an override and needs a note. interpretation_required can only be overridden.
%% -
%% -
%% ---------- Deferred to phase two ----------
%% Per-scope-item verdicts: add scope_item_id to assessment_run_controls and widen both run keys.
%% -
%% Not drawn, to keep the picture readable: every engagement_id foreign key, and
%% engagement_controls.updated_by_id, scope_items.created_by_id, assessment_criteria.created_by_id,
%% documents.uploaded_by_id and review_flags.cleared_by_id. Each is marked FK in its table.
erDiagram

    %% ---------- People and engagements ----------

    %% UNIQUE lower(email).
    %% CHECK (role = 'client') = (client_id IS NOT NULL).
    users {
        uuid id PK
        text external_id UK "Cognito subject, set when the user is invited"
        text email UK "Unique ignoring case"
        text display_name
        user_role role "No default; every invite names the role"
        uuid client_id FK "Set for client users only"
        timestamptz disabled_at "Set when an admin disables the user"
        timestamptz created_at
    }

    clients {
        uuid id PK
        text name
        timestamptz created_at
    }

    %% Isolation boundary. Every engagement-scoped table carries engagement_id.
    engagements {
        uuid id PK
        uuid client_id FK
        uuid lead_consultant_id FK
        text name
        engagement_status status "default draft"
        timestamptz created_at
    }

    engagement_frameworks {
        uuid engagement_id PK, FK
        uuid framework_id PK, FK
    }

    %% One row per control of each framework in the engagement. Rows are created when a framework
    %% is attached, and the catalog import adds rows for any new control of that framework.
    %% FK (engagement_id, framework_id) to engagement_frameworks.
    %% FK (control_id, framework_id) to controls (id, framework_id).
    %% CHECK is_applicable OR justification IS NOT NULL.
    engagement_controls {
        uuid engagement_id PK, FK
        uuid control_id PK, FK
        uuid framework_id FK
        boolean is_applicable "default true"
        text justification "Required when not applicable"
        uuid updated_by_id FK
        timestamptz updated_at
    }

    %% Hard-deleted; their mentions are deleted with them (cascade).
    %% UNIQUE (engagement_id, type, name). UNIQUE (id, engagement_id).
    scope_items {
        uuid id PK
        uuid engagement_id FK
        scope_item_type type
        text name
        text_array aliases "Alternate names used for entity matching"
        text description
        uuid created_by_id FK "Client user or consultant"
        timestamptz created_at
    }

    %% ---------- Framework catalog (loaded by the catalog import task) ----------

    %% UNIQUE (key, version).
    frameworks {
        uuid id PK
        text key "e.g. iso_27001"
        text name
        text version "e.g. 2022"
    }

    %% Loaded by import-catalog from a private S3 bucket, in one transaction. Never deleted.
    %% UNIQUE (framework_id, ref_code). UNIQUE (id, framework_id).
    %% CHECK theme IN ('organizational', 'people', 'physical', 'technological').
    controls {
        uuid id PK
        uuid framework_id FK
        text ref_code "e.g. 5.1, 8.24"
        text theme
        text title
        text statement "The standard's own text. Licensed; never in the repository"
    }

    %% Insert-only apart from is_active.
    %% UNIQUE (control_id, version). UNIQUE (control_id, id).
    %% Partial unique (control_id) WHERE is_active: one active version per control.
    assessment_criteria {
        uuid id PK
        uuid control_id FK
        int version
        text_array expected_evidence "One entry per kind of evidence; each is a search query"
        text pass_conditions
        text fail_conditions
        boolean requires_operation_evidence "default false"
        boolean is_active "default false"
        uuid created_by_id FK
        timestamptz created_at
    }

    %% Empty in phase one.
    %% UNIQUE (source_control_id, target_control_id). CHECK source_control_id <> target_control_id.
    control_mappings {
        uuid id PK
        uuid source_control_id FK
        uuid target_control_id FK
        mapping_relationship relationship
        text provider
        timestamptz fetched_at
    }

    %% ---------- Documents and retrieval ----------

    %% A replacement retires the old document: when it is ready, the old document and its chunks
    %% get deleted_at in the same transaction.
    %% UNIQUE (id, engagement_id).
    %% Partial unique (engagement_id, content_hash) WHERE deleted_at IS NULL AND status <> 'failed'.
    %% Partial unique (replaces_document_id) WHERE deleted_at IS NULL AND status <> 'failed'.
    %% CHECK replaces_document_id <> id.
    %% FK (replaces_document_id, engagement_id) to documents (id, engagement_id).
    %% CHECK text_source IN ('embedded', 'text_recognition').
    %% CHECK (status = 'failed') = (error IS NOT NULL).
    %% Index (engagement_id, status).
    %% Trigger: AFTER UPDATE OF deleted_at copies the value to the document's existing chunks.
    documents {
        uuid id PK
        uuid engagement_id FK
        uuid uploaded_by_id FK
        text file_name
        text mime_type
        bigint size_bytes
        int page_count
        text content_hash "SHA-256 of the original file; set by the check step"
        text s3_key "Chosen by the server from the document ID"
        text s3_version_id "Recorded at confirm; the worker and downloads use only this version"
        text extracted_s3_key "Extracted text and locations as JSON"
        text text_source
        uuid replaces_document_id FK
        timestamptz deleted_at "Soft delete; search excludes"
        document_status status "default pending"
        text processing_step "Last completed step, for retries"
        text error "Set only when failed"
        timestamptz confirmed_at "Set when the upload is confirmed"
        timestamptz created_at
    }

    %% UNIQUE (id, engagement_id).
    %% FK (document_id, engagement_id) to documents (id, engagement_id).
    %% Partial unique (document_id, chunk_index) WHERE superseded_at IS NULL.
    %% HNSW on embedding (cosine) WHERE deleted_at IS NULL AND superseded_at IS NULL.
    %% Search sets hnsw.iterative_scan and filters on embedding_model.
    %% GIN on search_vector. Index (engagement_id). Index (document_id).
    %% Trigger: BEFORE INSERT copies the document's deleted_at, so chunks written after a delete stay hidden.
    document_chunks {
        uuid id PK
        uuid document_id FK
        uuid engagement_id FK "Denormalized for filtered search"
        int chunk_index
        jsonb locator "page, sheet and range, or slide"
        text section_title
        text content
        int token_count
        vector_1024 embedding "Matches the Bedrock embedding model"
        text embedding_model
        text chunker "e.g. xlsx-rows-v2"
        timestamptz superseded_at "Set by re-chunking; search excludes"
        timestamptz deleted_at "Copied from the document by triggers; search excludes"
        tsvector search_vector "Generated from content"
    }

    %% FK (chunk_id, engagement_id) to document_chunks (id, engagement_id).
    %% FK (scope_item_id, engagement_id) to scope_items (id, engagement_id).
    %% Index (scope_item_id). The scope item FK cascades on delete.
    chunk_scope_mentions {
        uuid chunk_id PK, FK
        uuid scope_item_id PK, FK
        uuid engagement_id FK
        text matched_text
        mention_method method
    }

    %% ---------- Assessments and review ----------

    %% UNIQUE (id, engagement_id). Index (engagement_id, created_at).
    %% Partial unique (engagement_id) WHERE status IN ('queued', 'running'): one active run per engagement.
    assessment_runs {
        uuid id PK
        uuid engagement_id FK
        uuid triggered_by_id FK "Consultant or admin"
        text model_id "Bedrock model identifier"
        text prompt_version
        run_status status "default queued"
        timestamptz started_at
        timestamptz completed_at
        timestamptz created_at
    }

    %% One row per control a run queues, with the criteria version active at the start.
    %% FK (control_id, assessment_criteria_id) to assessment_criteria (control_id, id).
    %% A row is finished when it has an assessment or failed_at is set.
    %% CHECK (failed_at IS NULL) = (error IS NULL).
    assessment_run_controls {
        uuid run_id PK, FK
        uuid control_id PK, FK
        uuid assessment_criteria_id FK
        timestamptz failed_at "Set after the last retry fails"
        text error
    }

    %% Append-only apart from is_current.
    %% UNIQUE (id, engagement_id). UNIQUE (run_id, control_id).
    %% FK (run_id, control_id) to assessment_run_controls; the criteria version comes from there.
    %% FK (run_id, engagement_id) to assessment_runs (id, engagement_id).
    %% FK (scope_item_id, engagement_id) to scope_items (id, engagement_id).
    %% Partial unique (engagement_id, control_id, scope_item_id) NULLS NOT DISTINCT WHERE is_current.
    assessments {
        uuid id PK
        uuid run_id FK
        uuid engagement_id FK
        uuid control_id FK
        uuid scope_item_id FK "Always null in phase one"
        preliminary_verdict verdict
        text rationale
        boolean is_current "default true"
        timestamptz created_at
    }

    %% FK (assessment_id, engagement_id) to assessments (id, engagement_id).
    %% FK (chunk_id, engagement_id) to document_chunks (id, engagement_id).
    %% CHECK (is_verified AND char_start IS NOT NULL AND char_end > char_start)
    %%    OR (NOT is_verified AND char_start IS NULL AND char_end IS NULL).
    %% Index (assessment_id). Index (chunk_id).
    evidence_citations {
        uuid id PK
        uuid assessment_id FK
        uuid chunk_id FK
        uuid engagement_id FK
        text quoted_text
        int char_start "Character offset in the chunk's content; null if unverified"
        int char_end "Null if unverified"
        boolean is_verified "True when the quote was found in the chunk"
    }

    %% A decision_superseded flag goes on the new assessment and names the one it replaced.
    %% FK (assessment_id, engagement_id) to assessments (id, engagement_id).
    %% FK (document_id, engagement_id) to documents (id, engagement_id).
    %% CHECK (reason IN ('document_deleted', 'document_replaced')) = (document_id IS NOT NULL).
    %% FK (superseded_assessment_id, engagement_id) to assessments (id, engagement_id).
    %% CHECK (reason = 'decision_superseded') = (superseded_assessment_id IS NOT NULL).
    %% CHECK (cleared_at IS NULL) = (cleared_by_id IS NULL).
    %% Partial unique (assessment_id, reason, document_id) NULLS NOT DISTINCT WHERE cleared_at IS NULL.
    %% Index (assessment_id) WHERE cleared_at IS NULL. Index (engagement_id) WHERE cleared_at IS NULL.
    review_flags {
        uuid id PK
        uuid assessment_id FK
        uuid engagement_id FK
        review_flag_reason reason
        uuid document_id FK "The deleted or replaced document"
        uuid superseded_assessment_id FK "The earlier assessment that had the decision"
        timestamptz created_at
        timestamptz cleared_at "Set when a consultant has re-reviewed"
        uuid cleared_by_id FK
    }

    %% Append-only. The decision of record is the latest by (decided_at, id).
    %% Index (assessment_id, decided_at DESC, id DESC).
    consultant_decisions {
        uuid id PK
        uuid assessment_id FK
        uuid decided_by_id FK "Consultant or admin"
        final_verdict final_verdict
        text notes "Required for an override"
        timestamptz decided_at "default now()"
    }

    %% Append-only record of every change (RV-6). engagement_id is null for firm-level actions.
    %% FK (engagement_id) to engagements. Index (engagement_id, occurred_at). Index (entity_type, entity_id).
    audit_events {
        uuid id PK
        uuid engagement_id FK
        uuid actor_id FK
        text action "e.g. scope_item.updated, applicability.set, document.deleted"
        text entity_type
        uuid entity_id
        jsonb details "Changed fields, old and new values"
        timestamptz occurred_at "default now()"
    }

    %% ---------- Relationships ----------

    clients ||--o{ users : "has client users"
    clients ||--o{ engagements : "has"
    users ||--o{ engagements : "leads"
    engagements ||--o{ engagement_frameworks : "uses"
    frameworks ||--o{ engagement_frameworks : "used by"
    engagements ||--o{ engagement_controls : "sets applicability"
    engagement_frameworks ||--o{ engagement_controls : "provides controls"
    controls ||--o{ engagement_controls : "applies to"
    engagements ||--o{ scope_items : "covers"

    frameworks ||--o{ controls : "contains"
    controls ||--o{ assessment_criteria : "has versions"
    controls ||--o{ control_mappings : "maps from"
    controls ||--o{ control_mappings : "maps to"

    engagements ||--o{ documents : "holds"
    documents |o--o| documents : "replaces"
    documents ||--o{ document_chunks : "split into"
    document_chunks ||--o{ chunk_scope_mentions : "mentions"
    scope_items ||--o{ chunk_scope_mentions : "mentioned in"

    engagements ||--o{ assessment_runs : "runs"
    users ||--o{ assessment_runs : "starts"
    assessment_runs ||--|{ assessment_run_controls : "queues"
    controls ||--o{ assessment_run_controls : "queued as"
    assessment_criteria ||--o{ assessment_run_controls : "snapshotted in"
    assessment_run_controls ||--o| assessments : "assessed as"
    scope_items |o--o{ assessments : "scoped to"
    assessments ||--o{ evidence_citations : "cites"
    document_chunks ||--o{ evidence_citations : "quoted in"
    assessments ||--o{ review_flags : "flagged by"
    documents |o--o{ review_flags : "named in"
    assessments ||--o{ consultant_decisions : "decided by"
    users ||--o{ consultant_decisions : "records"
    assessments |o--o{ review_flags : "superseded in"
    engagements |o--o{ audit_events : "logs"
    users ||--o{ audit_events : "acts in"
